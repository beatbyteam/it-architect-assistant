COMPOSE_PROJECT_NAME=it-arch-mvp

POSTGRES_DB=it_arch_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

APP_NAME="IT Architect Assistant Backend"
APP_VERSION=0.1.0
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
ALLOWED_CORS_ORIGINS=["http://localhost:8080","http://localhost:4173"]

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/it_arch_assistant
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_QUEUES=default,knowledge_extraction,knowledge_vectorization,knowledge_llm_extraction,architecture_generation,architecture_verification

HEALTH_CHECK_WORKER=true
HEALTH_CHECK_REDIS=true
HEALTH_CHECK_DB=true
HEALTH_CHECK_LLM=false
HEALTH_CHECK_EMBEDDING=false
HEALTH_CHECK_ACTIVE_KNOWLEDGE_VERSION=false

REQUEST_ID_HEADER=X-Request-ID
AUTH_MODE=local_noauth
AUTH_HEADER_LOGIN=X-Auth-Login
AUTH_HEADER_DISPLAY_NAME=X-Auth-Display-Name
AUTH_HEADER_ROLES=X-Auth-Roles
AUTH_HEADER_ACCOUNT_TYPE=X-Auth-Account-Type
AUTH_DEFAULT_DISPLAY_NAME=User
LOCAL_USER_LOGIN=local.user
LOCAL_USER_DISPLAY_NAME="Local User"
LOCAL_USER_ROLES=["USER"]
LOCAL_USER_ACCOUNT_TYPE=human
MVP_PERMISSIVE_LOCAL_ACCESS=true
MVP_GLOBAL_ROLE_CODES=ADMIN,MVP_ADMIN

KNOWLEDGE_FETCH_TIMEOUT_SEC=30
KNOWLEDGE_UPLOAD_DIR=./data/knowledge_uploads
KNOWLEDGE_ALLOWED_LOCAL_SOURCE_ROOTS=["./data/knowledge_uploads","./data/knowledge_sources","./app/bootstrap/knowledge_bundle"]
KNOWLEDGE_ALLOW_UNRESTRICTED_LOCAL_SOURCES=false
KNOWLEDGE_CHUNK_MAX_CHARS=1800
KNOWLEDGE_CHUNK_TARGET_TOKENS=300
KNOWLEDGE_CHUNK_OVERLAP_PCT=12
KNOWLEDGE_LARGE_DOCUMENT_THRESHOLD_BYTES=1048576
KNOWLEDGE_LARGE_DOCUMENT_CHUNK_MAX_CHARS=3600
KNOWLEDGE_LARGE_DOCUMENT_CHUNK_TARGET_TOKENS=600
KNOWLEDGE_LARGE_DOCUMENT_CHUNK_OVERLAP_PCT=8
KNOWLEDGE_LARGE_DOCUMENT_MAX_CHUNKS=640
KNOWLEDGE_LLM_EXTRACTION_MAX_CHUNKS=128
KNOWLEDGE_LOCAL_EMBEDDING_MAX_CHUNKS=0
KNOWLEDGE_AUTO_SYNC_INTERVAL_DAYS=30
KNOWLEDGE_EXECUTE_INLINE=false
KNOWLEDGE_SYNC_SLA_SECONDS=3600
KNOWLEDGE_MAX_DOCUMENT_SIZE_BYTES=104857600
KNOWLEDGE_MAX_UPLOAD_SIZE_BYTES=104857600

EMBEDDING_PROFILE=bge_m3_default
EMBEDDING_PROVIDER=local_openai_compatible
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=http://ollama:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SEC=300
EMBEDDING_BATCH_SIZE=96
EMBEDDING_MODEL_ID=bge-m3

RERANKER_PROVIDER=heuristic
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_TIMEOUT_SEC=30
RERANKER_MODEL_ID=

GENERATION_EXECUTE_INLINE=false
GENERATION_RETRIEVAL_LIMIT=16
GENERATION_SECTION_RETRIEVAL_LIMIT=2
GENERATION_PROMPT_MAX_INPUT_TOKENS=6500
GENERATION_PROMPT_RESERVED_OUTPUT_TOKENS=1600
GENERATION_PROMPT_FRAGMENT_CHAR_LIMIT=2200
VERIFICATION_RULE_RAG_LIMIT=8
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_TIMEOUT_SEC=1800
LLM_MODEL_ID=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.1
LLM_TOP_P=
LLM_MAX_TOKENS=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL_ID=
VISION_PROVIDER=disabled
VISION_BASE_URL=http://ollama:11434/v1
VISION_API_KEY=
VISION_MODEL_ID=
VISION_TIMEOUT_SEC=120

VERIFICATION_EXECUTE_INLINE=false

VITE_API_BASE_URL=http://localhost:8080/api/v1
